{
  "version": "1.10.1-alpha",
  "readOnly": true,
  "site": {
    "timezone": "America/Lima"
  },
  "collector": {
    "collectorId": "COLLECTOR-LOCAL-01",
    "siteId": "SITE01",
    "name": "Dream Collector Local"
  },
  "discovery": {
    "enabled": true,
    "rootPath": "..\\Dream",
    "dreamPattern": "Dream*_1.mdb",
    "discoveryMode": "report-only"
  },
  "runtime": {
    "queryTimeoutSeconds": 30,
    "sampleRows": 25,
    "maxRowsPerQuery": 200,
    "realtimeMode": false,
    "enablePerformanceMetrics": true,
    "logLevel": "INFO"
  },
  "extractionMode": "DISCOVERY",
  "allowCandidateMappings": false,
  "dreams": [],
  "realtime": {
    "enabled": true,
    "pollIntervalSeconds": 30,
    "allowCandidateMappings": false,
    "maxConsecutiveFailures": 10,
    "retentionSessions": 120
  },
  "operationalState": {
    "maxEvidenceAgeMinutes": 10,
    "allowStaleForTesting": false
  },
  "incidents": {
    "mode": "candidate",
    "sendWhatsApp": false,
    "repeatUntilResolved": true,
    "requirePhotoEvidence": false,
    "requireObservation": true,
    "episodeGapMinutes": 30,
    "slaPreviewReminders": 5
  },
  "routing": {
    "mode": "candidate",
    "requiredRoles": [
      "REGADOR",
      "SUPERVISOR",
      "COORDINADOR"
    ],
    "users": [],
    "assignments": []
  },
  "incidentPersistence": {
    "backend": "sqlite",
    "path": "runtime/incident_state.db",
    "migrationTarget": "AZURE_POSTGRESQL"
  },
  "notifications": {
    "mode": "candidate",
    "channel": "WHATSAPP",
    "realSendingEnabled": false,
    "outboxEnabled": true
  },
  "incidentEvidencePolicies": {
    "mode": "candidate",
    "policySource": "LOCAL_CONFIG_UNTIL_AZURE",
    "default": {
      "requiresPhotoEvidence": false,
      "requiresObservation": true,
      "requiresResolutionValidation": true
    },
    "byIncidentType": {
      "EXAMPLE_INCIDENT_REQUIRING_PHOTO": {
        "requiresPhotoEvidence": true
      }
    }
  }
}
